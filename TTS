<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cute Accent TTS Player 🎧</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts (Fredoka & Nunito) -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        pastel: {
                            pink: '#FFD1DC',
                            purple: '#E2F0CB',
                            lavender: '#E6E6FA',
                            blue: '#B5EAD7',
                            yellow: '#FFDAC1',
                            card: '#FFF9F5',
                            accent: '#FF9AA2',
                            darkText: '#5A4A42'
                        }
                    },
                    fontFamily: {
                        fredoka: ['Fredoka', 'sans-serif'],
                        nunito: ['Nunito', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Nunito', sans-serif;
            background-color: #F7F5F0;
            background-image: radial-gradient(#E2DCD5 1px, transparent 1px);
            background-size: 20px 20px;
        }

        /* Cute Custom Scrollbar */
        textarea::-webkit-scrollbar {
            width: 8px;
        }
        textarea::-webkit-scrollbar-track {
            background: #FFF0ED;
            border-radius: 10px;
        }
        textarea::-webkit-scrollbar-thumb {
            background: #FFB7B2;
            border-radius: 10px;
        }

        /* Sound Wave Animation */
        .wave-bar {
            animation: wave 1.2s ease-in-out infinite alternate;
        }
        @keyframes wave {
            0% { height: 6px; }
            100% { height: 32px; }
        }
        .wave-bar:nth-child(1) { animation-delay: 0.0s; }
        .wave-bar:nth-child(2) { animation-delay: 0.2s; }
        .wave-bar:nth-child(3) { animation-delay: 0.4s; }
        .wave-bar:nth-child(4) { animation-delay: 0.1s; }
        .wave-bar:nth-child(5) { animation-delay: 0.3s; }

        /* Custom Range Slider Styling */
        input[type=range] {
            -webkit-appearance: none;
            width: 100%;
            background: transparent;
        }
        input[type=range]:focus {
            outline: none;
        }
        input[type=range]::-webkit-slider-runnable-track {
            width: 100%;
            height: 10px;
            cursor: pointer;
            background: #FFE5EC;
            border-radius: 10px;
        }
        input[type=range]::-webkit-slider-thumb {
            height: 20px;
            width: 20px;
            border-radius: 50%;
            background: #FF80BF;
            cursor: pointer;
            -webkit-appearance: none;
            margin-top: -5px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.15);
            transition: transform 0.1s ease;
        }
        input[type=range]::-webkit-slider-thumb:hover {
            transform: scale(1.2);
        }

        /* Floating Animation for Header Mascot */
        .bounce-soft {
            animation: bounceSoft 3s ease-in-out infinite;
        }
        @keyframes bounceSoft {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-8px) rotate(3deg); }
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4 md:p-6 text-pastel-darkText">

    <!-- App Container -->
    <div class="w-full max-w-2xl bg-white rounded-3xl shadow-xl border-4 border-white overflow-hidden flex flex-col my-auto relative">
        
        <!-- Header Section -->
        <header class="bg-gradient-to-r from-pastel-pink via-pastel-yellow to-pastel-blue p-6 text-center relative border-b-2 border-pink-100">
            <div class="inline-block bg-white p-3 rounded-full shadow-md mb-2 bounce-soft text-3xl">
                🎙️✨
            </div>
            <h1 class="font-fredoka text-3xl md:text-4xl text-gray-800 tracking-wide font-bold">Accent Master</h1>
            <p class="text-sm font-semibold text-gray-600 mt-1">미국식 & 영국식 억양을 남성/여성 목소리로 들어보세요!</p>
        </header>

        <!-- Main Content Body -->
        <main class="p-6 md:p-8 space-y-6 bg-pastel-card">
            
            <!-- Text Input Area Container -->
            <div class="relative bg-white rounded-2xl p-4 border-2 border-pink-100 shadow-sm focus-within:border-pink-300 transition-all">
                <textarea 
                    id="text-input" 
                    rows="4" 
                    placeholder="여기에 듣고 싶은 영어 문장을 입력하세요... (예: Have a wonderful day!)"
                    class="w-full resize-none outline-none font-nunito text-lg text-gray-700 bg-transparent placeholder-gray-400"
                ></textarea>
                
                <!-- Helper Actions Under Textarea -->
                <div class="flex justify-between items-center pt-2 border-t border-gray-100 mt-2">
                    <span id="char-count" class="text-xs font-semibold text-gray-400">0자</span>
                    <div class="flex space-x-2">
                        <button id="btn-copy" onclick="copyText()" class="px-3 py-1 text-xs font-bold rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-600 transition flex items-center gap-1">
                            <i class="fa-regular fa-copy"></i> 복사
                        </button>
                        <button id="btn-clear" onclick="clearText()" class="px-3 py-1 text-xs font-bold rounded-xl bg-pink-100 hover:bg-pink-200 text-pink-600 transition flex items-center gap-1">
                            <i class="fa-solid fa-trash-can"></i> 지우기
                        </button>
                    </div>
                </div>
            </div>

            <!-- Sample Sentences Chips -->
            <div>
                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">
                    💡 추천 sample 문장 클릭해보기
                </label>
                <div class="flex flex-wrap gap-2">
                    <button onclick="setSample('How are you doing today? I hope you have a fantastic day!')" class="text-xs font-bold bg-white hover:bg-pastel-pink/40 border border-pink-200 px-3 py-1.5 rounded-full text-gray-700 transition shadow-sm hover:scale-105 active:scale-95">
                        😊 Everyday Greeting
                    </button>
                    <button onclick="setSample('Excuse me, could you tell me how to get to the nearest train station?')" class="text-xs font-bold bg-white hover:bg-pastel-blue/40 border border-blue-200 px-3 py-1.5 rounded-full text-gray-700 transition shadow-sm hover:scale-105 active:scale-95">
                        🗺️ Asking Directions
                    </button>
                    <button onclick="setSample('I would love a cup of hot Earl Grey tea with a splash of milk, please.')" class="text-xs font-bold bg-white hover:bg-pastel-purple/40 border border-green-200 px-3 py-1.5 rounded-full text-gray-700 transition shadow-sm hover:scale-105 active:scale-95">
                        ☕ Ordering Tea
                    </button>
                </div>
            </div>

            <!-- Voice Selection Options -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                
                <!-- Accent Toggle (US / UK) -->
                <div class="bg-white p-4 rounded-2xl border-2 border-gray-100 shadow-sm">
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">
                        🌐 억양 선택 (Accent)
                    </label>
                    <div class="grid grid-cols-2 gap-2 p-1 bg-gray-50 rounded-xl">
                        <button id="accent-us" onclick="setAccent('US')" class="py-2.5 rounded-lg text-sm font-bold flex items-center justify-center gap-2 transition bg-pastel-pink text-gray-800 shadow-sm">
                            🇺🇸 미국식 (US)
                        </button>
                        <button id="accent-uk" onclick="setAccent('UK')" class="py-2.5 rounded-lg text-sm font-bold flex items-center justify-center gap-2 transition text-gray-500 hover:text-gray-700">
                            🇬🇧 영국식 (UK)
                        </button>
                    </div>
                </div>

                <!-- Gender Toggle (Female / Male) -->
                <div class="bg-white p-4 rounded-2xl border-2 border-gray-100 shadow-sm">
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">
                        👤 성별 선택 (Gender)
                    </label>
                    <div class="grid grid-cols-2 gap-2 p-1 bg-gray-50 rounded-xl">
                        <button id="gender-female" onclick="setGender('female')" class="py-2.5 rounded-lg text-sm font-bold flex items-center justify-center gap-2 transition bg-pastel-pink text-gray-800 shadow-sm">
                            👩 여성 (Female)
                        </button>
                        <button id="gender-male" onclick="setGender('male')" class="py-2.5 rounded-lg text-sm font-bold flex items-center justify-center gap-2 transition text-gray-500 hover:text-gray-700">
                            👨 남성 (Male)
                        </button>
                    </div>
                </div>
            </div>

            <!-- Voice Pitch / Speed Slider Controls -->
            <div class="bg-white p-4 rounded-2xl border-2 border-gray-100 shadow-sm space-y-4">
                <div>
                    <div class="flex justify-between text-xs font-bold text-gray-600 mb-1">
                        <span>⚡ 말하기 속도 (Speed)</span>
                        <span id="rate-val" class="text-pink-500 font-extrabold">1.0x</span>
                    </div>
                    <input type="range" id="rate" min="0.5" max="1.5" step="0.1" value="1.0" oninput="updateControls()">
                </div>
                <div>
                    <div class="flex justify-between text-xs font-bold text-gray-600 mb-1">
                        <span>🎵 음높이 (Pitch)</span>
                        <span id="pitch-val" class="text-pink-500 font-extrabold">1.0</span>
                    </div>
                    <input type="range" id="pitch" min="0.5" max="1.5" step="0.1" value="1.0" oninput="updateControls()">
                </div>
            </div>

            <!-- Sound Wave Visualizer (When Playing) -->
            <div id="visualizer" class="h-10 flex items-center justify-center gap-1.5 opacity-0 transition-opacity duration-300">
                <div class="wave-bar w-2 bg-pink-400 rounded-full"></div>
                <div class="wave-bar w-2 bg-purple-400 rounded-full"></div>
                <div class="wave-bar w-2 bg-blue-400 rounded-full"></div>
                <div class="wave-bar w-2 bg-yellow-400 rounded-full"></div>
                <div class="wave-bar w-2 bg-pink-400 rounded-full"></div>
            </div>

            <!-- Play Controls Buttons -->
            <div class="flex gap-3">
                <button 
                    id="btn-play" 
                    onclick="speakText()" 
                    class="flex-1 bg-gradient-to-r from-pink-400 to-rose-400 hover:from-pink-500 hover:to-rose-500 text-white font-fredoka font-semibold text-xl py-4 rounded-2xl shadow-lg hover:shadow-xl active:scale-98 transition transform flex items-center justify-center gap-2"
                >
                    <i id="play-icon" class="fa-solid fa-play"></i> <span id="play-btn-text">음성 재생하기</span>
                </button>
                <button 
                    id="btn-stop" 
                    onclick="stopSpeaking()" 
                    class="bg-gray-100 hover:bg-gray-200 text-gray-600 font-bold px-6 py-4 rounded-2xl transition flex items-center justify-center text-lg active:scale-95"
                    title="정지"
                >
                    <i class="fa-solid fa-square"></i>
                </button>
            </div>

            <!-- Current Voice Badge Info -->
            <div class="text-center">
                <span id="voice-info" class="inline-block text-xs font-semibold px-3 py-1 rounded-full bg-pink-50 text-pink-600 border border-pink-100">
                    🔍 감지된 보이스 로딩 중...
                </span>
            </div>

        </main>
        
        <!-- Toast Notification Area -->
        <div id="toast" class="fixed bottom-6 left-1/2 transform -translate-x-1/2 bg-gray-800 text-white text-xs font-bold px-4 py-2 rounded-full shadow-xl opacity-0 transition-all pointer-events-none z-50">
            메시지
        </div>
    </div>

    <!-- Application Logic -->
    <script>
        // SpeechSynthesis setup
        const synth = window.speechSynthesis;
        let voices = [];
        
        // Settings State
        let currentAccent = 'US'; // 'US' or 'UK'
        let currentGender = 'female'; // 'female' or 'male'
        let selectedVoice = null;

        // UI Elements
        const textInput = document.getElementById('text-input');
        const charCount = document.getElementById('char-count');
        const rateInput = document.getElementById('rate');
        const pitchInput = document.getElementById('pitch');
        const rateVal = document.getElementById('rate-val');
        const pitchVal = document.getElementById('pitch-val');
        const visualizer = document.getElementById('visualizer');
        const voiceInfo = document.getElementById('voice-info');
        const playBtnText = document.getElementById('play-btn-text');
        const playIcon = document.getElementById('play-icon');

        // Character counter
        textInput.addEventListener('input', () => {
            charCount.textContent = `${textInput.value.length}자`;
        });

        // Populate available speech voices
        function populateVoices() {
            voices = synth.getVoices();
            findMatchingVoice();
        }

        // Initialize voices when available
        populateVoices();
        if (speechSynthesis.onvoiceschanged !== undefined) {
            speechSynthesis.onvoiceschanged = populateVoices;
        }

        // Find the most suitable voice based on Accent and Gender
        function findMatchingVoice() {
            if (!voices.length) return;

            const targetLang = currentAccent === 'US' ? 'en-US' : 'en-GB';
            
            // Gender detection heuristics based on voice name keywords
            const femaleKeywords = ['female', 'zira', 'samantha', 'victoria', 'karen', 'fiona', 'hazel', 'google us english', 'google uk english female', 'natural female'];
            const maleKeywords = ['male', 'david', 'alex', 'george', 'daniel', 'richard', 'james', 'google uk english male', 'natural male'];

            const targetKeywords = currentGender === 'female' ? femaleKeywords : maleKeywords;

            // 1. Filter by language first
            const langVoices = voices.filter(v => v.lang.replace('_', '-').includes(targetLang));

            if (langVoices.length > 0) {
                // 2. Try matching gender keywords
                let genderMatch = langVoices.find(v => 
                    targetKeywords.some(kw => v.name.toLowerCase().includes(kw))
                );

                // 3. Fallback: If searching male and none found by keyword, pick one that doesn't match female keywords
                if (!genderMatch && currentGender === 'male') {
                    genderMatch = langVoices.find(v => !femaleKeywords.some(kw => v.name.toLowerCase().includes(kw)));
                }

                // 4. Default fallback to first voice matching language
                selectedVoice = genderMatch || langVoices[0];
            } else {
                // Global fallback to any English voice
                selectedVoice = voices.find(v => v.lang.startsWith('en')) || voices[0];
            }

            // Update Voice Label
            if (selectedVoice) {
                voiceInfo.textContent = `🎤 적용된 보이스: ${selectedVoice.name} (${selectedVoice.lang})`;
            } else {
                voiceInfo.textContent = '⚠️ 지원되는 영어 음성을 찾지 못했습니다.';
            }
        }

        // Toggle Accent Button State
        function setAccent(accent) {
            currentAccent = accent;
            
            const btnUS = document.getElementById('accent-us');
            const btnUK = document.getElementById('accent-uk');

            if (accent === 'US') {
                btnUS.className = 'py-2.5 rounded-lg text-sm font-bold flex items-center justify-center gap-2 transition bg-pastel-pink text-gray-800 shadow-sm';
                btnUK.className = 'py-2.5 rounded-lg text-sm font-bold flex items-center justify-center gap-2 transition text-gray-500 hover:text-gray-700';
            } else {
                btnUK.className = 'py-2.5 rounded-lg text-sm font-bold flex items-center justify-center gap-2 transition bg-pastel-blue text-gray-800 shadow-sm';
                btnUS.className = 'py-2.5 rounded-lg text-sm font-bold flex items-center justify-center gap-2 transition text-gray-500 hover:text-gray-700';
            }

            findMatchingVoice();
            showToast(`${accent === 'US' ? '🇺🇸 미국식' : '🇬🇧 영국식'} 억양이 선택되었습니다.`);
        }

        // Toggle Gender Button State
        function setGender(gender) {
            currentGender = gender;
            
            const btnFemale = document.getElementById('gender-female');
            const btnMale = document.getElementById('gender-male');

            if (gender === 'female') {
                btnFemale.className = 'py-2.5 rounded-lg text-sm font-bold flex items-center justify-center gap-2 transition bg-pastel-pink text-gray-800 shadow-sm';
                btnMale.className = 'py-2.5 rounded-lg text-sm font-bold flex items-center justify-center gap-2 transition text-gray-500 hover:text-gray-700';
            } else {
                btnMale.className = 'py-2.5 rounded-lg text-sm font-bold flex items-center justify-center gap-2 transition bg-pastel-yellow text-gray-800 shadow-sm';
                btnFemale.className = 'py-2.5 rounded-lg text-sm font-bold flex items-center justify-center gap-2 transition text-gray-500 hover:text-gray-700';
            }

            findMatchingVoice();
            showToast(`${gender === 'female' ? '👩 여성' : '👨 남성'} 목소리가 선택되었습니다.`);
        }

        // Update Slider Display Labels
        function updateControls() {
            rateVal.textContent = parseFloat(rateInput.value).toFixed(1) + 'x';
            pitchVal.textContent = parseFloat(pitchInput.value).toFixed(1);
        }

        // Set Text from Sample Buttons
        function setSample(text) {
            textInput.value = text;
            charCount.textContent = `${text.length}자`;
            showToast('샘플 문장이 입력되었습니다! ✨');
        }

        // Copy Text
        function copyText() {
            if (!textInput.value.trim()) {
                showToast('복사할 문장이 없습니다!');
                return;
            }
            // Clipboard copy fallbacks
            textInput.select();
            document.execCommand('copy');
            showToast('📋 클립보드에 복사되었습니다!');
        }

        // Clear Text
        function clearText() {
            textInput.value = '';
            charCount.textContent = '0자';
            stopSpeaking();
            showToast('🧹 텍스트가 지워졌습니다.');
        }

        // Speech Output Execution
        function speakText() {
            if (synth.speaking) {
                synth.cancel();
            }

            const text = textInput.value.trim();
            if (!text) {
                showToast('⚠️ 재생할 문장을 입력해주세요!');
                return;
            }

            const utterance = new SpeechSynthesisUtterance(text);

            if (selectedVoice) {
                utterance.voice = selectedVoice;
            }

            utterance.rate = parseFloat(rateInput.value);
            utterance.pitch = parseFloat(pitchInput.value);

            // Speech Start Event
            utterance.onstart = () => {
                visualizer.style.opacity = '1';
                playBtnText.textContent = '재생 중...';
                playIcon.className = 'fa-solid fa-waveform';
            };

            // Speech End Event
            utterance.onend = () => {
                visualizer.style.opacity = '0';
                playBtnText.textContent = '음성 재생하기';
                playIcon.className = 'fa-solid fa-play';
            };

            // Error Handling
            utterance.onerror = (e) => {
                console.error('Speech Synthesis Error:', e);
                visualizer.style.opacity = '0';
                playBtnText.textContent = '음성 재생하기';
                playIcon.className = 'fa-solid fa-play';
                showToast('❌ 음성 재생 중 오류가 발생했습니다.');
            };

            synth.speak(utterance);
        }

        // Stop Speech
        function stopSpeaking() {
            if (synth.speaking) {
                synth.cancel();
                visualizer.style.opacity = '0';
                playBtnText.textContent = '음성 재생하기';
                playIcon.className = 'fa-solid fa-play';
                showToast('⏹️ 재생이 정지되었습니다.');
            }
        }

        // Show Toast Utility
        let toastTimeout;
        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.textContent = msg;
            toast.style.opacity = '1';

            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.style.opacity = '0';
            }, 2000);
        }
    </script>
</body>
</html>
