<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🌈 Lesson 4 Travel Quest</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Jua&family=Nunito:wght@500;700;800&display=swap');
:root{
  --pink:#ff8fb1; --peach:#ffb48a; --yellow:#ffd96a; --mint:#8edfc0;
  --blue:#8ec5ff; --purple:#b59cff; --ink:#4d4661; --cream:#fffaf5;
}
*{box-sizing:border-box}
body{
  margin:0; min-height:100vh; font-family:'Nunito','Malgun Gothic',sans-serif;
  color:var(--ink);
  background:
    radial-gradient(circle at 10% 10%,#fff 0 7%,transparent 7.5%),
    radial-gradient(circle at 90% 20%,#fff 0 5%,transparent 5.5%),
    linear-gradient(135deg,#ffeef5,#fff8df 45%,#e9f8ff);
}
button{font:inherit}
.app{max-width:980px;margin:auto;padding:22px 18px 45px}
.top{
  display:flex;align-items:center;justify-content:space-between;gap:15px;
  background:rgba(255,255,255,.82);border:3px solid #fff;border-radius:28px;
  padding:14px 18px;box-shadow:0 12px 30px #8b779a22;backdrop-filter:blur(8px)
}
.logo{font-family:Jua;font-size:27px;color:#6b5b8e}
.stats{display:flex;gap:9px;flex-wrap:wrap;justify-content:flex-end}
.pill{padding:8px 13px;border-radius:18px;background:#fff3f7;font-weight:800}
.progress-wrap{margin:18px 2px 12px}
.progress{height:14px;background:#fff;border-radius:20px;overflow:hidden;box-shadow:inset 0 1px 5px #8b779a22}
.bar{height:100%;width:0;background:linear-gradient(90deg,var(--pink),var(--purple),var(--blue));transition:.35s}
.screen{display:none}.screen.active{display:block}
.home{
  text-align:center;padding:42px 20px 50px;background:rgba(255,255,255,.78);
  border-radius:35px;box-shadow:0 18px 45px #7b6b8a20
}
.hero{font-size:76px;animation:bob 2s infinite ease-in-out}
@keyframes bob{50%{transform:translateY(-9px) rotate(2deg)}}
h1,h2{font-family:Jua;margin:8px 0}
h1{font-size:44px;color:#675482}.sub{font-size:17px;line-height:1.65}
.mode-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:15px;max-width:720px;margin:28px auto}
.mode{
  border:0;border-radius:25px;padding:22px;background:#fff;cursor:pointer;text-align:left;
  box-shadow:0 8px 18px #7b6b8a18;transition:.2s;position:relative;overflow:hidden
}
.mode:hover{transform:translateY(-4px);box-shadow:0 13px 24px #7b6b8a25}
.mode b{display:block;font-family:Jua;font-size:22px;margin-bottom:5px}
.mode span{font-size:13px}
.mode .emoji{font-size:36px;float:right}
.start{background:linear-gradient(135deg,#ff91b2,#b49aff)!important;color:white!important}
.quiz-card{
  background:rgba(255,255,255,.9);border-radius:32px;padding:28px;
  box-shadow:0 16px 40px #75688920;max-width:860px;margin:auto
}
.meta{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px;font-weight:800}
.category{background:#f2ebff;color:#735d9c;padding:7px 12px;border-radius:15px}
.question{font-family:Jua;font-size:29px;line-height:1.4;text-align:center;margin:25px 5px 22px}
.korean{font-family:'Malgun Gothic';font-size:16px;background:#fff8e7;padding:13px 17px;border-radius:17px;text-align:center;margin:-8px auto 20px;max-width:720px}
.options{display:grid;grid-template-columns:repeat(2,1fr);gap:13px}
.opt{
  border:3px solid #eee8f4;background:white;border-radius:20px;padding:17px;
  cursor:pointer;text-align:left;font-weight:800;color:var(--ink);transition:.18s;min-height:62px
}
.opt:hover{border-color:#bda9ed;transform:scale(1.015)}
.opt.correct{background:#e7faef;border-color:#63c990;color:#25734c}
.opt.wrong{background:#fff0f2;border-color:#ff7e9c;color:#a63d59}
.opt:disabled{cursor:default}
.feedback{
  display:none;margin-top:18px;border-radius:20px;padding:16px;text-align:center;font-weight:800;
  animation:pop .25s
}
.feedback.show{display:block}.good{background:#e7faef;color:#28734d}.bad{background:#fff0f2;color:#a13d58}
@keyframes pop{from{transform:scale(.96);opacity:.2}to{transform:scale(1);opacity:1}}
.next{
  display:none;width:100%;margin-top:15px;border:0;border-radius:19px;padding:15px;
  background:#675482;color:#fff;font-weight:900;cursor:pointer
}
.next.show{display:block}
.stars{font-size:23px;letter-spacing:2px}
.result{text-align:center;padding:45px 20px;background:rgba(255,255,255,.9);border-radius:32px}
.score{font-family:Jua;font-size:72px;color:#675482}
.result-box{max-width:560px;margin:20px auto;padding:20px;background:#fff8e7;border-radius:24px}
.restart{border:0;background:linear-gradient(135deg,#ff91b2,#b49aff);color:#fff;padding:15px 30px;border-radius:20px;font-weight:900;cursor:pointer}
.tiny{font-size:12px;color:#8c8297;margin-top:20px}
@media(max-width:650px){
 .mode-grid,.options{grid-template-columns:1fr}
 h1{font-size:35px}.question{font-size:24px}.hero{font-size:60px}
 .top{align-items:flex-start}.stats{max-width:230px}
}
</style>
</head>
<body>
<div class="app">
  <div class="top">
    <div class="logo">✈️ Travel Quest · Lesson 4</div>
    <div class="stats">
      <div class="pill">⭐ <span id="score">0</span></div>
      <div class="pill">🔥 <span id="combo">0</span></div>
    </div>
  </div>

  <div class="progress-wrap"><div class="progress"><div class="bar" id="bar"></div></div></div>

  <section id="home" class="screen active">
    <div class="home">
      <div class="hero">🧳🐰🌈</div>
      <h1>Travel Quest!</h1>
      <p class="sub">중1 동아 윤정미 4과 핵심을<br><b>귀여운 여행 게임</b>으로 정복해 보자! ✨</p>
      <div class="mode-grid">
        <button class="mode start" onclick="startGame('all')"><span class="emoji">🎮</span><b>ALL QUEST</b><span>어휘 + 대화 + 문법 + 본문</span></button>
        <button class="mode" onclick="startGame('vocab')"><span class="emoji">🧸</span><b>VOCAB LAND</b><span>여행 어휘 & 표현</span></button>
        <button class="mode" onclick="startGame('grammar')"><span class="emoji">📚</span><b>GRAMMAR CAFE</b><span>동명사 & be going to</span></button>
        <button class="mode" onclick="startGame('reading')"><span class="emoji">💌</span><b>READING TRIP</b><span>본문 & 대화 이해</span></button>
      </div>
      <p class="tiny">※ 파일의 핵심 학습 내용과 문제 유형을 바탕으로 만든 연습용 게임입니다.</p>
    </div>
  </section>

  <section id="quiz" class="screen">
    <div class="quiz-card">
      <div class="meta">
        <span class="category" id="cat">GRAMMAR</span>
        <span><span id="qnum">1</span> / <span id="total">10</span></span>
      </div>
      <div class="stars" id="stars">☆☆☆☆☆</div>
      <div class="question" id="question"></div>
      <div class="korean" id="korean" style="display:none"></div>
      <div class="options" id="options"></div>
      <div class="feedback" id="feedback"></div>
      <button class="next" id="next" onclick="nextQuestion()">다음 문제 ➜</button>
    </div>
  </section>

  <section id="result" class="screen">
    <div class="result">
      <div style="font-size:65px">🏆✨🧳</div>
      <h1>Quest Complete!</h1>
      <div class="score"><span id="finalScore">0</span></div>
      <div id="finalMessage"></div>
      <div class="result-box">
        <b>📊 결과</b><br><br>
        총 <span id="finalTotal">0</span>문제 중 <b><span id="correctCount">0</span></b>개 정답<br>
        최고 콤보 🔥 <b><span id="bestCombo">0</span></b>
      </div>
      <button class="restart" onclick="goHome()">🏠 다시 여행하기</button>
    </div>
  </section>
</div>

<script>
const Q = [
/* VOCAB */
{type:'vocab',q:'“explore”의 뜻으로 가장 알맞은 것은?',o:['설명하다','탐험하다','주문하다','지불하다'],a:1,e:'explore = 탐험하다'},
{type:'vocab',q:'“souvenir”의 뜻은?',o:['기념품','입구','절벽','일정'],a:0,e:'souvenir = 기념품'},
{type:'vocab',q:'“fee”의 뜻으로 알맞은 것은?',o:['문화','요금','전망','거리'],a:1,e:'fee = 요금'},
{type:'vocab',q:'“narrow”의 반대말은?',o:['famous','local','wide','perfect'],a:2,e:'narrow = 좁은 ↔ wide = 넓은'},
{type:'vocab',q:'다음 영영풀이에 해당하는 단어는? “to get pleasure from something”',o:['enjoy','rent','pay','trail'],a:0,e:'enjoy = to get pleasure from something'},
{type:'vocab',q:'“to give money to someone for something you buy or for a service”에 해당하는 단어는?',o:['spend','pay','rent','visit'],a:1,e:'pay = 돈을 지불하다'},
{type:'vocab',q:'“view”가 ‘의견, 견해’라는 뜻으로 쓰인 문장은?',o:['The view from the top was amazing.','We enjoyed the ocean view.','His view on the problem is different from mine.','The hotel has a beautiful view.'],a:2,e:'view는 경치/전망 또는 의견/견해라는 두 가지 뜻이 있다.'},
{type:'vocab',q:'“against”가 ‘~을 배경으로’라는 뜻인 문장은?',o:['Our team is playing against Italy.','The stars shine against the dark sky.','They walked against the wind.','We played against another class.'],a:1,e:'against + 배경 = ~을 배경으로'},
{type:'vocab',q:'rent → rental과 같은 관계인 것은?',o:['enter → entrance','beautiful → beauty','travel → trip','narrow → wide'],a:0,e:'rent + -al → rental, enter + -ance → entrance'},
{type:'vocab',q:'다음 중 “be famous for ~”의 뜻은?',o:['~을 기대하다','~로 유명하다','~을 통과하다','~을 빌리다'],a:1,e:'be famous for = ~로 유명하다'},
{type:'vocab',q:'“on one’s way to ~”의 뜻은?',o:['~을 배경으로','~로 가는 도중에','~을 하루 종일','~을 기대하며'],a:1,e:'on one’s way to ~ = ~로 가는 길/도중에'},
{type:'vocab',q:'“be full of ~”의 뜻은?',o:['~로 가득 차 있다','~을 방문하다','~을 주문하다','~을 즐기다'],a:0,e:'be full of = ~로 가득 차 있다'},
/* GRAMMAR */
{type:'grammar',q:'(Ride / Riding) a bicycle is fun.',o:['Ride','Riding','To ride','Rode'],a:1,e:'동명사구가 주어로 쓰여 ‘자전거를 타는 것은’이라는 뜻이다.'},
{type:'grammar',q:'I enjoy ______ pictures.',o:['take','to take','taking','took'],a:2,e:'enjoy는 목적어로 동명사(-ing)를 취한다.'},
{type:'grammar',q:'She is good at ______ English.',o:['speak','speaking','to speak','spoke'],a:1,e:'전치사 at 뒤에는 명사/동명사가 온다.'},
{type:'grammar',q:'다음 중 동명사가 주어로 쓰인 문장은?',o:['I enjoy reading books.','Reading books is fun.','She is reading a book.','He will read a book.'],a:1,e:'Reading books가 문장의 주어이다.'},
{type:'grammar',q:'다음 중 어법상 올바른 문장은?',o:['Sarah enjoys to swim.','Are you good at draw?','I finished cooking spaghetti.','Do you mind to close the door?'],a:2,e:'finish는 동명사를 목적어로 취한다.'},
{type:'grammar',q:'I’m going to ______ math tonight.',o:['studying','study','studied','studies'],a:1,e:'be going to + 동사원형'},
{type:'grammar',q:'다음 중 be going to의 의문문으로 올바른 것은?',o:['You are going to play soccer?','Are you going to play soccer?','Are going you to play soccer?','Going are you to play soccer?'],a:1,e:'Be동사 + 주어 + going to + 동사원형?'},
{type:'grammar',q:'다음 중 be going to의 부정문으로 올바른 것은?',o:['I don’t going to travel.','I’m not going to travel.','I not am going to travel.','I’m going not to travel.'],a:1,e:'be동사 뒤에 not을 넣는다.'},
{type:'grammar',q:'“그녀는 댄스 수업을 받지 않을 것이다.”에 알맞은 문장은?',o:['She not is going to take dance lessons.','She isn’t going to take dance lessons.','She doesn’t going to take dance lessons.','She isn’t going taking dance lessons.'],a:1,e:'She + is not + going to + take'},
{type:'grammar',q:'“너는 언제 만날 거니?”에 알맞은 문장은?',o:['When are you going to meet?','When you are going to meet?','When do you going to meet?','When are going meet you?'],a:0,e:'의문사 + be동사 + 주어 + going to + 동사원형'},
{type:'grammar',q:'“I was going to call you, but I forgot.”에서 was going to의 의미는?',o:['지금 전화하는 중이다','전화할 계획이었지만 하지 않았다','전화하지 않을 예정이다','전화하고 싶지 않다'],a:1,e:'was/were going to는 과거에 하려고 계획했으나 실제로 하지 않은 일을 나타낸다.'},
{type:'grammar',q:'다음 중 올바른 문장은?',o:['My team is going to practicing.','My team going to practice.','My team is going to practice.','My team are going to practice.'],a:2,e:'team을 단수로 보고 is + going to + practice를 사용한다.'},
/* DIALOGUE */
{type:'dialogue',q:'A: What are you going to do this summer?\\nB: ______ swimming lessons.',o:['I’m going take','I’m going to take','I going to take','I’m take'],a:1,e:'계획을 말할 때 I’m going to + 동사원형을 쓴다.'},
{type:'dialogue',q:'“나는 그것이 기대돼.”에 가장 알맞은 표현은?',o:['I’m looking forward to it.','I’m looking for it.','I’m looking at it.','I’m looking it forward.'],a:0,e:'look forward to = ~을 기대하다'},
{type:'dialogue',q:'I’m looking forward to ______ her again.',o:['see','seeing','to see','saw'],a:1,e:'look forward to의 to는 전치사이므로 뒤에 동명사(-ing)가 온다.'},
{type:'dialogue',q:'A: Do you have any plans for this weekend?\\nB: ______',o:['Yes. I’m going to go to an amusement park.','Yes. I went there yesterday.','No, I am cooking yesterday.','I was going there last year.'],a:0,e:'주말 계획을 묻는 질문이므로 미래 계획으로 답한다.'},
{type:'dialogue',q:'“Sounds fun!”과 가장 가까운 의미는?',o:['재미있겠다!','싫어 보여!','걱정돼!','지루하겠다!'],a:0,e:'Sounds fun! = 재미있겠다!'},
{type:'dialogue',q:'A: Can I join you?\\nB: ______',o:['Sure!','I’m looking forward.','I can’t wait to it.','No, I did.'],a:0,e:'Can I ~?로 허락을 구하면 Sure! 등으로 답할 수 있다.'},
{type:'dialogue',q:'다음 중 계획을 묻는 표현이 아닌 것은?',o:['What are you going to do this weekend?','What’s your plan for next month?','Do you have any plans for the holidays?','What do you usually do after school?'],a:3,e:'usually는 평소 습관을 묻는 표현이다.'},
{type:'dialogue',q:'다음 대화의 빈칸에 가장 알맞은 것은?\\nA: Ann, what are you going to ______?\\nB: A chicken salad.',o:['order','rent','explore','visit'],a:0,e:'What are you going to order? = 무엇을 주문할 거니?'},
/* READING */
{type:'reading',q:'Ronda의 대부분의 건물은 무슨 색인가?',o:['보라색','파란색','흰색','빨간색'],a:2,e:'본문에서 Ronda의 대부분의 건물은 white라고 설명한다.'},
{type:'reading',q:'Ronda가 아름다운 전망을 가진 이유와 관련된 내용은?',o:['바다에 있기 때문에','절벽 위에 있기 때문에','큰 도시에 있기 때문에','눈이 많이 오기 때문에'],a:1,e:'Ronda is on cliffs, so the views are fantastic.'},
{type:'reading',q:'Minji가 점심으로 특히 좋아한 음식은?',o:['민트 차','추로스','햄버거','진주 사탕'],a:1,e:'Minji는 음식 중 특히 churros를 좋아한다고 썼다.'},
{type:'reading',q:'Chefchaouen에서 Uncle Jay가 마신 것은?',o:['커피','주스','민트 차','우유'],a:2,e:'그는 tea house에서 mint tea를 마신다.'},
{type:'reading',q:'Chefchaouen은 무엇으로 유명한가?',o:['일출','곤돌라','서핑','뮤지컬'],a:0,e:'Chefchaouen is famous for its sunrises.'},
{type:'reading',q:'Amy가 Purple Island에서 자전거로 탐험하려는 이유는?',o:['섬이 매우 크기 때문에','섬이 크지 않기 때문에','입장료가 비싸기 때문에','말을 타기 위해'],a:1,e:'The island does not big라는 본문 오류 수정 형태의 핵심 내용은 island is not big.'},
{type:'reading',q:'다음 중 본문 내용과 일치하는 것은?',o:['Chefchaouen의 거리는 넓고 비어 있다.','Ronda의 모든 건물은 파란색이다.','Amy는 Purple Island의 Lavender Garden 방문을 기대한다.','Uncle Jay는 밤에 일출을 볼 예정이다.'],a:2,e:'Amy: I’m especially looking forward to visiting the Lavender Garden.'},
{type:'reading',q:'London 일정에서 오후에 방문할 장소는?',o:['Tower Bridge','Tower of London','a musical','a restaurant'],a:1,e:'오전에는 Tower Bridge, 오후에는 Tower of London, 저녁에는 musical.'},
{type:'reading',q:'London 일정의 마지막 활동은?',o:['Tower Bridge 방문','Tower of London 방문','뮤지컬 보기','쇼핑하기'],a:2,e:'Lastly, they’re going to see a musical in the evening.'},
{type:'reading',q:'다음 중 4과의 글 전체를 가장 잘 나타내는 제목은?',o:['A Journey to Colorful Villages','How to Cook Thai Food','My School Life','The History of London'],a:0,e:'Ronda, Chefchaouen, Purple Island 등 색으로 유명한 장소를 여행하는 편지글이다.'}
];

let list=[], idx=0, score=0, combo=0, best=0, correct=0, answered=false;

function startGame(mode){
  list = mode==='all' ? shuffle([...Q]).slice(0,24) : shuffle(Q.filter(x=>x.type===mode)).slice(0,10);
  idx=0;score=0;combo=0;best=0;correct=0;answered=false;
  document.getElementById('score').textContent=0;
  document.getElementById('combo').textContent=0;
  document.getElementById('total').textContent=list.length;
  show('quiz'); render();
}
function shuffle(a){return a.sort(()=>Math.random()-0.5)}
function show(id){document.querySelectorAll('.screen').forEach(x=>x.classList.remove('active'));document.getElementById(id).classList.add('active')}
function render(){
  answered=false;
  const q=list[idx];
  document.getElementById('qnum').textContent=idx+1;
  document.getElementById('cat').textContent={vocab:'🧸 VOCAB',grammar:'📚 GRAMMAR',dialogue:'💬 DIALOGUE',reading:'💌 READING'}[q.type];
  document.getElementById('question').innerHTML=q.q.replace(/\\n/g,'<br>');
  document.getElementById('korean').style.display='none';
  const opt=document.getElementById('options');opt.innerHTML='';
  q.o.forEach((x,i)=>{
    const b=document.createElement('button');b.className='opt';b.innerHTML=`<span style="opacity:.5">${String.fromCharCode(①.charCodeAt(0)+i)}</span> ${x}`;
    b.onclick=()=>answer(i,b);opt.appendChild(b);
  });
  document.getElementById('feedback').className='feedback';
  document.getElementById('feedback').innerHTML='';
  document.getElementById('next').className='next';
  document.getElementById('bar').style.width=(idx/list.length*100)+'%';
  document.getElementById('stars').textContent='⭐'.repeat(Math.min(5,Math.max(0,combo)))+'☆'.repeat(Math.max(0,5-Math.min(5,combo)));
}
function answer(choice,btn){
  if(answered)return;answered=true;
  const q=list[idx], buttons=[...document.querySelectorAll('.opt')];
  buttons.forEach(b=>b.disabled=true);
  if(choice===q.a){
    btn.classList.add('correct');correct++;combo++;best=Math.max(best,combo);
    score += 100 + (combo-1)*20;
    document.getElementById('feedback').className='feedback show good';
    document.getElementById('feedback').innerHTML=`🎉 정답! +${100+(combo-1)*20}점<br><small>${q.e}</small>`;
  }else{
    btn.classList.add('wrong');buttons[q.a].classList.add('correct');combo=0;
    document.getElementById('feedback').className='feedback show bad';
    document.getElementById('feedback').innerHTML=`💡 아쉬워요! 정답은 <b>${q.o[q.a]}</b><br><small>${q.e}</small>`;
  }
  document.getElementById('score').textContent=score;
  document.getElementById('combo').textContent=combo;
  document.getElementById('stars').textContent='⭐'.repeat(Math.min(5,Math.max(0,combo)))+'☆'.repeat(Math.max(0,5-Math.min(5,combo)));
  document.getElementById('next').className='next show';
}
function nextQuestion(){
  idx++;
  if(idx>=list.length){finish();return}
  render();
}
function finish(){
  document.getElementById('bar').style.width='100%';
  document.getElementById('finalScore').textContent=score;
  document.getElementById('finalTotal').textContent=list.length;
  document.getElementById('correctCount').textContent=correct;
  document.getElementById('bestCombo').textContent=best;
  const rate=correct/list.length;
  document.getElementById('finalMessage').innerHTML=rate===1?'🌟 PERFECT! 여행 영어 마스터!':rate>=.8?'🎀 GREAT! 거의 다 맞혔어요!':rate>=.6?'🌷 NICE! 조금만 더 연습해 봐요!':'🐣 괜찮아요! 다시 도전하면 더 잘할 수 있어요!';
  show('result');
}
function goHome(){document.getElementById('bar').style.width='0';show('home')}
const circ=['①','②','③','④','⑤'];
/* replace fragile circ char logic */
const originalRender=render;
render=function(){
  answered=false;
  const q=list[idx];
  document.getElementById('qnum').textContent=idx+1;
  document.getElementById('cat').textContent={vocab:'🧸 VOCAB',grammar:'📚 GRAMMAR',dialogue:'💬 DIALOGUE',reading:'💌 READING'}[q.type];
  document.getElementById('question').innerHTML=q.q.replace(/\\n/g,'<br>');
  const opt=document.getElementById('options');opt.innerHTML='';
  q.o.forEach((x,i)=>{
    const b=document.createElement('button');b.className='opt';b.innerHTML=`<span style="opacity:.55">${circ[i]}</span> ${x}`;
    b.onclick=()=>answer(i,b);opt.appendChild(b);
  });
  document.getElementById('feedback').className='feedback';
  document.getElementById('feedback').innerHTML='';
  document.getElementById('next').className='next';
  document.getElementById('bar').style.width=(idx/list.length*100)+'%';
  document.getElementById('stars').textContent='⭐'.repeat(Math.min(5,Math.max(0,combo)))+'☆'.repeat(Math.max(0,5-Math.min(5,combo)));
};
